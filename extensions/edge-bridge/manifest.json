{
  "manifest_version": 3,
  "name": "Mark-LV Existing Edge Session Bridge",
  "version": "1.0.0",
  "description": "Lets Mark-LV automate tabs in the already-open Edge window without launching another browser profile.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:18763/*", "http://localhost:18763/*", "<all_urls>"],
  "background": { "service_worker": "service_worker.js" },
  "options_page": "options.html",
  "action": { "default_title": "Mark-LV Browser Bridge", "default_popup": "popup.html" }
}